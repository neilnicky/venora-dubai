---
import Icon from "./Icon.astro";
import { enquiry } from "@/content/venora-content.ts";
import { siteConfig } from "@/content/site-config.ts";
import { interests, budgets, timings, limits } from "@/lib/enquiry.ts";
import { propertyTypes, typeLabels, allHomes } from "@/lib/homes.ts";

interface Props {
  /** Prefix for element ids, so the dialog and the /enquire page form never collide. */
  id: string;
}
const { id } = Astro.props;
const f = enquiry.fields;
const ig = siteConfig.contact.instagram;
// Lets the client resolve a preset home slug into its title and absolute URL.
const homeIndex = Object.fromEntries(allHomes().map((p) => [p.slug, { title: p.title, url: new URL(`/homes/${p.slug}`, Astro.site).href }]));
const config = { endpoint: siteConfig.enquiry.endpoint, dmUrl: ig.dmUrl, homes: homeIndex, copy: { errors: enquiry.errors, sending: enquiry.sending } };
---

<div class="enq" data-enquiry-root>
  <form class="enq__form" novalidate data-enquiry-form data-config={JSON.stringify(config)}>
    <div class="enq__home" data-home-chip hidden>
      <span class="small muted">{f.home}</span>
      <span class="enq__home-title" data-home-title></span>
      <button type="button" class="enq__home-clear" aria-label="Remove this home from the enquiry" data-home-clear><Icon name="close" /></button>
      <input type="hidden" name="home" value="" />
    </div>

    <div class="field">
      <label for={`${id}-name`}>{f.name}</label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required maxlength={limits.name} aria-describedby={`${id}-name-error`} />
      <p class="field__error" id={`${id}-name-error`} data-error-for="name" aria-live="polite"></p>
    </div>

    <fieldset class="field">
      <legend>{f.interest}</legend>
      <div class="chips">
        {
          Object.entries(interests).map(([value, label], i) => (
            <label class="chip">
              <input type="radio" name="interest" value={value} checked={i === 0} />
              <span>{label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="enq__row">
      <div class="field">
        <label for={`${id}-type`}>{f.propertyType}</label>
        <div class="select">
          <select id={`${id}-type`} name="propertyType">
            <option value="any">Any</option>
            {propertyTypes.map((t) => <option value={t}>{typeLabels[t].one}</option>)}
          </select>
          <Icon name="down" />
        </div>
      </div>
      <div class="field">
        <label for={`${id}-budget`}>{f.budget} <span class="muted">({enquiry.optional})</span></label>
        <div class="select">
          <select id={`${id}-budget`} name="budget">
            <option value="">Prefer not to say</option>
            {Object.entries(budgets).map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
          <Icon name="down" />
        </div>
      </div>
      <div class="field">
        <label for={`${id}-timing`}>{f.timing} <span class="muted">({enquiry.optional})</span></label>
        <div class="select">
          <select id={`${id}-timing`} name="timing">
            <option value="">Not sure yet</option>
            {Object.entries(timings).map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
          <Icon name="down" />
        </div>
      </div>
    </div>

    <div class="field">
      <label for={`${id}-message`}>{f.message} <span class="muted">({enquiry.optional})</span></label>
      <textarea id={`${id}-message`} name="message" rows="3" maxlength={limits.message} placeholder={f.messagePlaceholder} aria-describedby={`${id}-message-error`}></textarea>
      <p class="field__error" id={`${id}-message-error`} data-error-for="message" aria-live="polite"></p>
    </div>

    <div class="enq__submit">
      <button class="btn" type="submit" data-submit>
        <span data-submit-label>{siteConfig.enquiry.endpoint ? enquiry.submitEndpoint : enquiry.submit}</span><Icon name="arrow" />
      </button>
      <p class="small muted" data-form-status role="status"></p>
    </div>
  </form>

  <section class="enq__done" data-handoff hidden tabindex="-1" aria-labelledby={`${id}-done-title`}>
    <h3 class="h3" id={`${id}-done-title`} data-done-title>{enquiry.handoff.title}</h3>
    <p class="small" data-done-text>{enquiry.handoff.manual}</p>
    <label class="visually-hidden" for={`${id}-composed`}>Your message</label>
    <textarea class="enq__composed" id={`${id}-composed`} readonly rows="7" data-composed></textarea>
    <div class="actions" data-handoff-actions>
      <a class="btn" href={ig.dmUrl} target="_blank" rel="noopener" data-open-dm>
        <Icon name="instagram" />{enquiry.handoff.open}<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
      <button class="btn btn--outline" type="button" data-copy data-copied-label={enquiry.handoff.copiedShort}>{enquiry.handoff.copy}</button>
    </div>
    <p class="small muted" data-handoff-note>{enquiry.handoff.note}</p>
  </section>
  <script type="application/json" data-copy-text set:html={JSON.stringify({ ...enquiry.handoff, endpointSuccess: enquiry.endpointSuccess, endpointError: enquiry.endpointError })} />
</div>

<style>
  .enq__form {
    display: grid;
    gap: 1.4rem;
  }
  .field {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .field label,
  .field legend {
    padding: 0;
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .field legend {
    margin-bottom: 0.45rem;
  }
  input[type="text"],
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    font-size: 1rem;
    transition: border-color 0.2s;
    appearance: none;
  }
  textarea {
    resize: vertical;
    line-height: 1.5;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-bottom-color: var(--ink);
    box-shadow: 0 1px 0 var(--ink);
  }
  [aria-invalid="true"] {
    border-bottom-color: #a3361f;
  }
  .field__error {
    color: #a3361f;
    font-size: var(--fs-small);
  }
  .field__error:empty {
    display: none;
  }
  .select {
    position: relative;
  }
  .select :global(svg) {
    position: absolute;
    right: 0;
    top: 50%;
    width: 1rem;
    translate: 0 -50%;
    pointer-events: none;
  }
  .select select {
    padding-right: 1.5rem;
    cursor: pointer;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 100px;
    font-size: var(--fs-small);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .chip input:checked + span {
    background: var(--teal-900);
    border-color: var(--teal-900);
    color: var(--gold-200);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--gold-700);
    outline-offset: 2px;
  }
  .enq__row {
    display: grid;
    gap: 1.4rem;
  }
  @media (min-width: 640px) {
    .enq__row {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  .enq__home {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border-radius: var(--radius);
    background: var(--sand-100);
  }
  .enq__home[hidden] {
    display: none;
  }
  .enq__home-title {
    flex: 1;
    font-weight: 500;
  }
  .enq__home-clear {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .enq__home-clear :global(svg) {
    width: 1.1rem;
  }
  .enq__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .enq__done {
    display: grid;
    gap: 1rem;
  }
  .enq__done[hidden],
  [data-handoff-actions][hidden],
  [data-composed][hidden] {
    display: none;
  }
  .enq__done:focus {
    outline: none;
  }
  .enq__composed {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sand-100);
    font-size: var(--fs-small);
  }
</style>
