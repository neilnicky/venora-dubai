---
// How it works: Venora's DM-based enquiry process in three steps.
import Tone from "@/components/Tone.astro";
import Button from "@/components/Button.astro";
import { steps } from "@/content/venora-content.ts";
import { cta } from "@/content/navigation.ts";
---

<section class="section steps" id={steps.id} aria-labelledby="steps-title">
  <div class="container split">
    <div class="steps__head">
      <Tone line={steps.title} class="h2" id="steps-title" />
      <Button enquire>{cta.enquire}</Button>
    </div>
    <div>
      <p class="caption steps__label">{steps.label}</p>
      <ol class="steps__list" role="list">
        {
          steps.items.map((s, i) => (
            <li class="steps__item" data-reveal style={`transition-delay:${i * 0.08}s`}>
              <span class="steps__num small muted">{String(i + 1).padStart(2, "0")}</span>
              <p class="lead">
                {s.lead} <span class="em">{s.tail}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .steps__head {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1.75rem;
  }
  @media (min-width: 900px) {
    .steps__head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }
  .steps__label {
    margin-bottom: 1.25rem;
  }
  .steps__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .steps__item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .steps__num {
    padding-top: 0.45rem;
  }
</style>
