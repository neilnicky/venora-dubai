{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static Astro build served as Workers static assets; no adapter or Worker script needed.
  "name": "venora-dubai",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
