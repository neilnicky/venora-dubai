{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "test-results", "playwright-report", "media-source"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}
